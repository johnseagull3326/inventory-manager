{
  "schemaVersion": 1,
  "id": "inventory-manager",
  "version": "${version}",
  "name": "Inventory Manager",
  "description": "Set various rules for player inventories in minecraft",
  "authors": ["JohnSeagull"],
  "contact": {},
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "johnseagull.inventoryManager.client.InventoryManagerClient"
    ],
    "main": [
      "johnseagull.inventoryManager.InventoryManager"
    ]
  },
  "mixins": [
    "inventory-manager.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
